# Resend API key — lấy tại https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Email nhận thông báo liên hệ (sandbox resend.dev chỉ giao được tới email tài khoản Resend)
RESEND_CONTACT_TO=you@example.com

# Email gửi đi — đổi sang domain đã verify sau khi thêm domain trong dashboard Resend
# ví dụ: Liên hệ Sơn ABOSSI <lead@sonabossi.vn>
RESEND_CONTACT_FROM="Website Sonabossi <onboarding@resend.dev>"
